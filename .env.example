# Copy to .env.local. Never commit the real key.
ELEVENLABS_API_KEY=
UI_HOST=127.0.0.1
UI_PORT=3000
UI_ARTIFACT_ROOT=artifacts
UI_MAX_VIDEO_BYTES=524288000
UI_MAX_LOGO_BYTES=10485760
UI_DOWNLOAD_TIMEOUT_MS=120000
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
POC_POLL_INITIAL_MS=5000
POC_POLL_MAX_MS=30000
POC_OPERATION_TIMEOUT_MS=2700000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SUBTITLE_FONT_DIRECTORY=/usr/share/fonts/truetype/noto
