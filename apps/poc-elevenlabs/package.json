{
  "name": "@ai-localization/poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "poc": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "poc": "node --enable-source-maps dist/cli.js"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.26.0",
    "commander": "^14.0.0",
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "msw": "^2.0.0"
  }
}
