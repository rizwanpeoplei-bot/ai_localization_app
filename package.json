{
  "name": "ai-localization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspace=@ai-localization/poc",
    "typecheck": "npm run typecheck --workspace=@ai-localization/poc",
    "lint": "eslint apps/poc-elevenlabs/src apps/poc-elevenlabs/tests",
    "test": "npm run test --workspace=@ai-localization/poc",
    "test:unit": "npm run test:unit --workspace=@ai-localization/poc",
    "test:integration": "npm run test:integration --workspace=@ai-localization/poc",
    "poc": "node --enable-source-maps apps/poc-elevenlabs/dist/cli.js",
    "web": "node --enable-source-maps apps/poc-elevenlabs/dist/web-server.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
